{
  "name": "ryazdetailing-backend",
  "version": "1.0.0",
  "description": "Backend API для сайта РязДетейлинг: онлайн-запись, админка, Telegram-уведомления",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:seo": "node scripts/build-seo.js",
    "test": "node --test tests/unit/*.test.js",
    "optimize:uploads": "node scripts/optimize-uploads.js",
    "test:integration": "node tests/run-integration.js",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "@sentry/node": "^11.7.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.2",
    "sharp": "^0.35.5"
  }
}
