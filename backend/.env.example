# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ должен попадать в git / публичный доступ.

# Порт, на котором будет работать сервер
PORT=3000

# Секретный ключ для подписи JWT-токенов авторизации.
# Сгенерировать можно командой: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Учётные данные администратора по умолчанию.
# Создаются ОДИН раз при первом запуске, если база данных пустая.
# После первого входа рекомендуется сменить пароль через админку.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=замените_на_надёжный_пароль

MANAGER_LOGIN=manager
MANAGER_PASSWORD=замените_на_надёжный_пароль

# Telegram-бот для уведомлений о новых заявках.
# 1. Создайте бота через @BotFather в Telegram, получите токен.
# 2. Узнайте chat_id (например, через @userinfobot, или chat_id группы).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email для уведомлений о заявках (опционально, пока не используется в коде,
# зарезервировано на будущее — сейчас уведомления идут через Telegram).
NOTIFY_EMAIL=

# Дополнительные домены, которым разрешены запросы к API (CORS), через запятую.
# Если сайт и API на одном домене (Render, либо Nginx проксирует /api) — оставьте
# пустым: запросы со своего же хоста разрешены всегда. Значение * ничего не открывает.
FRONTEND_ORIGIN=

# --- SEO-страницы услуг (необязательно) ---
# Папка со статикой сайта (где лежит index.html). Если задана, сервер сам создаёт
# /services/<slug>/index.html для услуг из админки, sitemap.xml и robots.txt.
# ОБЯЗАТЕЛЬНО при NODE_ENV=production (сервер не стартует без него).
# Для демо без SEO-страниц задайте SEO_DISABLED=1 вместо SITE_DIR.
SITE_DIR=
SEO_DISABLED=
# Публичный адрес сайта — для canonical, sitemap и разметки.
SITE_URL=https://ryazdetailing.ru
# Минимум свободного места для /health/ready, МБ.
HEALTH_MIN_FREE_MB=200

# --- Отслеживание ошибок (необязательно) ---
# Адрес проекта из sentry.io (или своего GlitchTip). Пусто — отправка выключена.
# Тела запросов, cookie, телефоны, имена и IP НЕ отправляются — только тип ошибки, стек и адрес маршрута.
SENTRY_DSN=
# Метка окружения в отчётах (production / staging).
SENTRY_ENVIRONMENT=production

# ── Сроки хранения персональных данных (должны совпадать с политикой на privacy.html) ──
# Раз в сутки сервер обезличивает/удаляет данные старше срока. 0 — отключить правило.
RETENTION_BOOKINGS_MONTHS=36   # заявки: после срока имя/телефон/авто/комментарии стираются, суммы и даты остаются
RETENTION_MESSAGES_MONTHS=36   # сообщения с формы обратной связи удаляются
RETENTION_LOGS_DAYS=365        # журнал действий админки (в т.ч. IP событий безопасности)
