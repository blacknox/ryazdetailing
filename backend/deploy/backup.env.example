# Настройки offsite-бэкапа. Скопируйте в backup.env (chmod 600) и заполните.
# Если OFFSITE_REMOTE пуст — делаются только локальные копии (как раньше).

# Куда выгружать: remote из `rclone config` + путь/бакет.
# Примеры:  r2:ryazdetailing-backups   b2:ryazdetailing-backups   sftp-backup:/backups/ryazdetailing
OFFSITE_REMOTE=

# Хранилище можно описать прямо здесь (без `rclone config`). Пример для Cloudflare R2
# (имя remote «r2» берётся из имени переменных: RCLONE_CONFIG_<ИМЯ>_...):
# RCLONE_CONFIG_R2_TYPE=s3
# RCLONE_CONFIG_R2_PROVIDER=Cloudflare
# RCLONE_CONFIG_R2_ACCESS_KEY_ID=...
# RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=...
# RCLONE_CONFIG_R2_ENDPOINT=https://<ID_АККАУНТА>.r2.cloudflarestorage.com
# OFFSITE_REMOTE=r2:ryazdetailing-backups
# Для Backblaze B2: RCLONE_CONFIG_B2_TYPE=b2, RCLONE_CONFIG_B2_ACCOUNT=..., RCLONE_CONFIG_B2_KEY=...
# Права ключа — только на этот бакет (чтение/запись/удаление его файлов).

# Файл с паролем для шифрования копий (gpg AES-256) ПЕРЕД выгрузкой.
# В копиях лежат телефоны и имена клиентов, поэтому наружу они уходят только зашифрованными.
# Создать:  openssl rand -base64 32 > ~/.ryazdetailing-backup.pass && chmod 600 ~/.ryazdetailing-backup.pass
# ВАЖНО: сохраните этот пароль отдельно (менеджер паролей) — без него копии не расшифровать.
BACKUP_PASSPHRASE_FILE=

# Сколько копий хранить («дед-отец-сын»), и на сервере, и в удалённом хранилище:
#   KEEP_DAILY   — по одной копии на каждый из последних N дней (минимум 7);
#   KEEP_WEEKLY  — по одной на каждую из последних N недель;
#   KEEP_MONTHLY — по одной на каждый из последних N месяцев.
# Самая свежая копия не удаляется никогда. Старая настройка OFFSITE_KEEP_DAYS всё ещё понимается как KEEP_DAILY.
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12
# Первый раз после обновления скрипта: BACKUP_PRUNE_DRYRUN=1 ./backup.sh покажет, что было бы удалено, ничего не удаляя.

# Необязательно: адрес пинга (healthchecks.io и т.п.). Скрипт пингует его после успеха
# и на <адрес>/fail при ошибке; если пинги перестали приходить — сервис пришлёт уведомление.
HEALTHCHECK_URL=

# Необязательно: другой путь к конфигу rclone (по умолчанию ~/.config/rclone/rclone.conf)
# RCLONE_CONFIG=

# Только для отладки: разрешить выгрузку без шифрования (не рекомендуется).
# ALLOW_UNENCRYPTED_OFFSITE=1

# ── Уведомления об ошибках резервного копирования (deploy/notify.sh, нужен хотя бы один канал) ──
# Telegram берётся из .env приложения (TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID). С российских серверов он бывает недоступен — тогда:
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/…      # Slack/Mattermost/любой приёмник JSON {"text": "..."}
# NOTIFY_EMAIL=owner@example.ru                       # нужна команда mail/mailx на сервере
# MAX_AGE_HOURS=30                                    # сторож сообщит, если успешной копии не было дольше
