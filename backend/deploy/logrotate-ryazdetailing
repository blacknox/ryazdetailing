# /etc/logrotate.d/ryazdetailing — ротация логов: хранить не более 14 дней, без бесконечного роста.
# Срок должен совпадать с политикой конфиденциальности (site/privacy.html, раздел «Как долго мы храним данные»).
# Установка:  sudo bash deploy/install-logrotate.sh [пользователь-приложения]   (подставит пути и проверит конфиг)
# Журнал действий (audit) и события безопасности (блокировки входа) хранятся в БД и чистятся задачей retention (RETENTION_LOGS_DAYS=365).

# ── Nginx: access/error ──
/var/log/nginx/*.log {
    daily
    rotate 14
    maxage 14
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        # «|| true»: если nginx сейчас остановлен (нет pid-файла), ротация не должна считаться ошибкой
        [ -f /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)" || true
    endscript
}

# ── Приложение (pm2): stdout/stderr Node-процесса, см. deploy/ecosystem.config.js ──
__APP_DIR__/logs/*.log {
    su __USER__ __USER__
    daily
    rotate 14
    maxage 14
    missingok
    notifempty
    compress
    delaycompress
    # pm2 держит файл открытым — копируем и обнуляем, перезапуск приложения не нужен
    copytruncate
}
